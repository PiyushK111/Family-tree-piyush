# Copy this file to `.env` and fill in the values from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration -> Config
#
# These are PUBLIC identifiers, not secrets. Anyone can read them out of the shipped
# JavaScript bundle. What actually protects your data is firestore.rules. They live in
# GitHub Actions secrets only to keep them out of casual scraping.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The document id under /trees that this deployment shows.
VITE_TREE_ID=main
