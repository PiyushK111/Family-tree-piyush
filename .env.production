# Firebase config for production builds. Vite reads this file automatically
# during `npm run build`, so deploys work with no secret configuration.
#
# These six values are NOT secrets. A Firebase web config is a set of public
# identifiers: it is compiled into the JavaScript bundle and served to every
# visitor, so it is readable by anyone who opens the site either way. What
# actually protects the data is firestore.rules (public read, writes limited to
# the emails in the tree's `editors` array) plus the Authentication authorized
# domains list. Committing this reveals nothing that the deployed bundle does
# not already hand out.
#
# `.env` (gitignored) overrides these for local development.

VITE_FIREBASE_API_KEY=AIzaSyAzxKr6H7kO6UKlsr0O4nsvYoFJ194cnrs
VITE_FIREBASE_AUTH_DOMAIN=family-tree-pk.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=family-tree-pk
VITE_FIREBASE_STORAGE_BUCKET=family-tree-pk.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=849568513548
VITE_FIREBASE_APP_ID=1:849568513548:web:9b06375626b4120b1f3829

VITE_TREE_ID=main
